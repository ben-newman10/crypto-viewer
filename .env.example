# Coinbase API Credentials
COINBASE_API_KEY=your_api_key
COINBASE_API_SECRET=your_api_secret

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# Model used for recommendations. Must support structured outputs (JSON schema).
OPENAI_MODEL=gpt-4.1

# Optional: point at a custom OpenAI-compatible endpoint (e.g. Azure OpenAI,
# OpenRouter, a local proxy).
# OPENAI_BASE_URL=https://your-provider.example.com/v1

# Optional: override sampling temperature. Defaults to 0.25 — low, because this
# is a structured numeric task. Some gateways only accept temperature=1.
# OPENAI_TEMPERATURE=0.25

# Enable or disable AI recommendations
ENABLE_AI_RECOMMENDATIONS=true

# Supplementary market context: CoinGecko (market cap, circulating supply,
# all-time high) and alternative.me (Fear & Greed Index). Both are free and
# keyless. Set to 0 to skip them — the affected fields are then reported as
# explicitly unavailable, which lowers the confidence ceiling rather than
# quietly shrinking the evidence base.
CRYPTO_VIEWER_EXTERNAL_MARKET_DATA=1

# Let the analysis put forward coins you do NOT hold, screened from the coins
# Coinbase lists in your quote currency and ranked by market cap. Off by
# default. Unlike the market-context switch above this changes which assets the
# app talks about, not just how much it knows about them, so it is opt-in.
# CRYPTO_VIEWER_CANDIDATE_DISCOVERY=1

# How many candidates survive the screen. Each one costs a candle request and a
# card's worth of prompt, so this is the cost dial for the feature.
# CRYPTO_VIEWER_CANDIDATE_LIMIT=5

# How many market-cap-ranked coins to consider. One request either way; it only
# has to be large enough to cover everything Coinbase lists in the quote
# currency. At the time of writing all 23 tradeable GBP pairs sat inside the
# top 250.
# CRYPTO_VIEWER_UNIVERSE_SIZE=250

# Append-only audit log of every recommendation (grounding context in, model
# output out, groundedness result). Defaults to server_py/logs/.
# CRYPTO_VIEWER_RECOMMENDATION_LOG=server_py/logs/recommendations.jsonl

# Server Configuration
PORT=3001